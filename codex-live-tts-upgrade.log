+                old_weight = self._calibrated_ms / max(total_ms, 1e-6)
+                new_weight = duration_ms / max(total_ms, 1e-6)
+                self.noise_rms = self.noise_rms * old_weight + rms * new_weight
+                self._calibrated_ms = total_ms
+            else:
