+def needs_human_escalation(text: str) -> bool:
+    lowered = text.lower()
+    triggers = (
+        "operatore",
+        "persona",
+        "umano",
+        "parlare con qualcuno",
+        "assistenza umana",
+        "responsabile",
+    )
+    return any(trigger in lowered for trigger in triggers)
