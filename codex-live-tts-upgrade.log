 from __future__ import annotations
 
 import re
+import unicodedata
 
 
+PROTECTED_PATTERNS = [
+    re.compile(r"https?://\S+|www\.\S+", re.IGNORECASE),
+    re.compile(r"[\w.+-]+@[\w-]+(?:\.[\w-]+)+", re.IGNORECASE),
