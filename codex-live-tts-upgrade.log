@dataclass(frozen=True)
class VoiceSessionConfig:
    provider: str
    voice_id: str
    model: str
    speed: float
    stability: float
    similarity_boost: float | None
    style: float | None
    temperature: float | None
    seed: int | None
    sample_rate: int
    output_format: str
    loudness_target_lufs: float
    loudness_enabled: bool
    crossfade_ms: int
