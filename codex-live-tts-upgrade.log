 class AudioEvent:
     type: Literal["speech_start", "speech_end", "meter"]
     rms: float = 0.0
+    noise_rms: float = 0.0
+    start_threshold: float = 0.0
+    continue_threshold: float = 0.0
+    in_speech: bool = False
     samples: np.ndarray | None = None
     sample_rate: int | None = None
