+            item = queue.get_nowait()
+        except asyncio.QueueEmpty:
+            return count
+        if item is not None:
+            count += 1
+
+
+def needs_human_escalation(text: str) -> bool:
+    lowered = text.lower()
+    triggers = (
+        "operatore",
+        "persona",
+        "umano",
+        "parlare con qualcuno",
+        "assistenza umana",
+        "responsabile",
+    )
+    return any(trigger in lowered for trigger in triggers)
