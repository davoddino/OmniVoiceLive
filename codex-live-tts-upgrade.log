+        self.recorder.event(
+            "rag_result",
+            turn_id=runtime.turn_id,
+            used=result.used,
+            latency_ms=result.latency_ms,
+            timed_out=result.timed_out,
+            error=result.error,
+        )
+        await self.send_event(
+            "rag.result",
