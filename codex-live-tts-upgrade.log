+    def _find_delimiter_cut(
+        self,
+        buffer: str,
+        delimiters: str,
+        min_chars: int,
+        limit: int,
+    ) -> int | None:
+        spans = _protected_spans(buffer)
+        cuts: list[int] = []
+        for index, ch in enumerate(buffer[:limit]):
+            if ch not in delimiters:
+                continue
+            cut = index + 1
+            if cut >= min_chars and _valid_cut(cut, spans):
+                cuts.append(cut)
+        return cuts[-1] if cuts else None
