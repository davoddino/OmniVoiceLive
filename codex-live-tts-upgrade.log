+def _speak_email(match: re.Match[str]) -> str:
+    value = match.group(0)
+    value = value.replace("@", " chiocciola ")
+    value = value.replace(".", " punto ")
+    value = value.replace("_", " underscore ")
+    value = value.replace("-", " trattino ")
