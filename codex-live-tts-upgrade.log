+    async def _retrieve_rag(
+        self,
+        user_text: str,
+        runtime: TurnRuntime,
+    ) -> RAGResult:
+        if self.rag is None:
+            return RAGResult(False, "", [], 0)
+        result = await self.rag.retrieve(user_text, runtime.cancel)
+        fallback = bool(result.timed_out or result.error)
