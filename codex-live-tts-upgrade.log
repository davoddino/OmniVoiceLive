                             "content": language_instruction(language),
                         },
+                        *([rag_system_message(rag_context)] if rag_context else []),
                         *history[-10:],
                         {"role": "user", "content": prompt},
                     ],
diff --git a/live_tts/playback.py b/live_tts/playback.py
