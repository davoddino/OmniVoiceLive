+    text = re.sub(r"\b(?:tel\.?|telefono|phone)\s*[:.-]?\s*", "telefono ", text, flags=re.I)
+    text = re.sub(r"(?<![\w/])\+?(?:\d[\s.-]?){7,}\d(?![\w/])", _speak_digits, text)
