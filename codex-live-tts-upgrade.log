+            used=result.used,
+            latency_ms=result.latency_ms,
+            timed_out=result.timed_out,
+        )
+        if fallback and not self.config.rag_fallback_to_llm:
+            raise RuntimeError("RAG retrieval failed and fallback is disabled")
