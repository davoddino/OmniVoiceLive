+
+def _env_float_any(names: tuple[str, ...], default: float) -> float:
+    raw = _env_any(names, "")
+    return default if raw == "" else float(raw)
+
+
+def _env_bool_any(names: tuple[str, ...], default: bool) -> bool:
+    raw = _env_any(names, "")
+    if raw == "":
